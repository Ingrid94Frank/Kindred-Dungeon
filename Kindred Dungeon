import random


# ============================================================
# KINDRED DUNGEON
# ============================================================

print("===================================")
print("       KINDRED DUNGEON")
print("===================================")

name = input("Как тебя зовут, путешественник? ").strip()

print()
print(f"Добро пожаловать, {name}.")
print("Ты просыпаешься в холодной каменной комнате.")
print("Перед тобой старая деревянная дверь.")
print("Справа лежит ржавый меч.")
print("Слева стоит сундук.")


# ============================================================
# СОСТОЯНИЕ ПЕРСОНАЖА
# ============================================================

inventory = []

has_weapon = False
has_key = False
has_light = False

max_hp = 20
hp = 20

damage_bonus = 0
armor = 0

max_mana = 0
mana = 0

cast_speed = 1.0
player_class = "Без класса"
spell = None


# ============================================================
# СОСТОЯНИЕ МИРА
# ============================================================

room = 1
game_running = True

ratman_alive = True
chest_looted = False

# Ключ случайно появляется в одном из трёх мест:
# 1 — кровать
# 2 — стол
# 3 — вешалка
key_spawn_location = random.choice([1, 2, 3])


# ============================================================
# ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ
# ============================================================

def show_status():
    print()
    print(
        f"[ {player_class} | "
        f"Здоровье: {hp:.2f}/{max_hp} | "
        f"Броня: {armor} | "
        f"Урон: +{damage_bonus} ]"
    )

    if player_class == "Маг":
        print(f"[ Мана: {mana:.2f}/{max_mana} ]")

    print("Инвентарь:", inventory)


def add_item(item):
    inventory.append(item)


# ============================================================
# ГЛАВНЫЙ ЦИКЛ ИГРЫ
# ============================================================

while game_running:

    # ========================================================
    # КОМНАТА 1 — КАМЕННАЯ КОМНАТА
    # ========================================================

    if room == 1:

        print()
        action = input("Что ты делаешь? ").lower().strip()

        if not action:
            print("Ты ничего не делаешь.")
            continue

        print("\nТы решил:", action)

        # ----------------------------------------------------
        # МЕЧ
        # ----------------------------------------------------

        if "меч" in action:

            if has_weapon:

                if "ржавый меч" in inventory:
                    print("Ты уже держишь ржавый меч.")

                else:
                    print(
                        "Как только ты прикасаешься к рукояти меча, "
                        "он рассыпается в ржавую труху."
                    )

            else:

                print("Ты подходишь к мечу и поднимаешь его.")
                print("Ржавый меч добавлен в инвентарь.")
                print("(+5 к урону)")

                add_item("ржавый меч")

                damage_bonus += 5
                has_weapon = True

        # ----------------------------------------------------
        # СУНДУК
        # ----------------------------------------------------

        elif "сундук" in action:

            if (
                "бить" in action
                or "разбить" in action
                or "сломать" in action
                or "удар" in action
            ):

                print(
                    "Ты изо всех сил бьёшь по сундуку, "
                    "но на нём не остаётся даже царапины."
                )

            elif "затупившийся кинжал" in inventory:

                print("Сундук уже пуст.")

            elif has_weapon:

                print(
                    "Ты подходишь к сундуку, "
                    "но он намертво заклинил."
                )

            else:

                print(
                    "Ты открываешь сундук и находишь:"
                )
                print("10 золотых монет.")
                print("Затупившийся кинжал.")
                print("(+2 к урону)")

                add_item("10 золотых монет")
                add_item("затупившийся кинжал")

                damage_bonus += 2
                has_weapon = True

        # ----------------------------------------------------
        # ДВЕРЬ
        # ----------------------------------------------------

        elif "дверь" in action:

            if has_weapon and has_key:

                print(
                    "Ты вставляешь ключ в замок."
                )
                print(
                    "Замок щёлкает."
                )
                print(
                    "Ты открываешь дверь и спускаешься в подвал..."
                )

                room = 2
                continue

            elif has_weapon:

                print(
                    "Дверь заперта."
                )
                print(
                    "Нужен ключ."
                )

            else:

                print(
                    "Ты дёргаешь ручку двери."
                )
                print(
                    "Заперто."
                )
                print(
                    "Сначала тебе нужно найти оружие."
                )

        # ----------------------------------------------------
        # КРОВАТЬ
        # ----------------------------------------------------

        elif "кровать" in action:

            if not has_weapon:

                print(
                    "Слишком темно."
                )
                print(
                    "Сначала найди оружие."
                )

            elif has_key:

                print(
                    "Ты уже нашёл ключ."
                )

            elif key_spawn_location == 1:

                print(
                    "Ты заглядываешь под кровать."
                )
                print(
                    "Под пылью лежит КЛЮЧ ОТ ЗАПЕРТОЙ ДВЕРИ!"
                )

                add_item("ключ от двери")
                has_key = True

            else:

                print(
                    "Под кроватью только пыль."
                )

        # ----------------------------------------------------
        # СТОЛ
        # ----------------------------------------------------

        elif "стол" in action:

            if not has_weapon:

                print(
                    "Слишком темно!"
                )

            elif has_key:

                print(
                    "Здесь уже ничего нет."
                )

            elif key_spawn_location == 2:

                print(
                    "В тени под столом ты находишь коробку."
                )
                print(
                    "Внутри лежит КЛЮЧ ОТ ЗАПЕРТОЙ ДВЕРИ!"
                )

                add_item("ключ от двери")
                has_key = True

            else:

                print(
                    "В тени под столом абсолютно пусто."
                )

        # ----------------------------------------------------
        # ВЕШАЛКА
        # ----------------------------------------------------

        elif (
            "вешалк" in action
            or "одежд" in action
        ):

            if not has_weapon:

                print(
                    "Слишком темно!"
                )

            elif has_key:

                print(
                    "Здесь уже ничего нет."
                )

            elif key_spawn_location == 3:

                print(
                    "Под вешалкой с рваной одеждой "
                    "ты находишь коробку."
                )
                print(
                    "Внутри КЛЮЧ ОТ ЗАПЕРТОЙ ДВЕРИ!"
                )

                add_item("ключ от двери")
                has_key = True

            else:

                print(
                    "Коробки здесь нет."
                )

        # ----------------------------------------------------
        # ОСМОТР КОМНАТЫ
        # ----------------------------------------------------

        elif (
            "комнат" in action
            or "исслед" in action
            or "осмотр" in action
        ):

            if not has_weapon:

                print(
                    "Слишком темно."
                )
                print(
                    "Ты почти ничего не видишь."
                )

            else:

                print(
                    "Ты внимательно осматриваешь комнату..."
                )

                if "поношенная тельняшка" not in inventory:

                    print(
                        "В куче хлама ты находишь "
                        "поношенную тельняшку."
                    )
                    print("(+2 к броне)")

                    add_item("поношенная тельняшка")
                    armor += 2

                else:

                    print(
                        "Ничего нового ты не замечаешь."
                    )

        # ----------------------------------------------------
        # ПОСОХ
        # ----------------------------------------------------

        elif (
            "посох" in action
            and not has_weapon
        ):

            print(
                "Ты вытягиваешь из стены старый деревянный посох."
            )
            print(
                "(+1 к урону)"
            )

            add_item("старый посох")

            damage_bonus += 1
            has_weapon = True

        # ----------------------------------------------------
        # ИНВЕНТАРЬ
        # ----------------------------------------------------

        elif (
            "инвентарь" in action
            or "рюкзак" in action
        ):

            print(
                "Твой инвентарь:"
            )

            if inventory:
                for item in inventory:
                    print("-", item)
            else:
                print("Пусто.")

        # ----------------------------------------------------
        # НЕИЗВЕСТНОЕ ДЕЙСТВИЕ
        # ----------------------------------------------------

        else:

            print(
                "Я не понимаю это действие."
            )

        show_status()


    # ========================================================
    # КОМНАТА 2 — ПОДВАЛ
    # ========================================================

    elif room == 2:

        # ----------------------------------------------------
        # ВЫБОР КЛАССА
        # ----------------------------------------------------

        if player_class == "Без класса":

            print()
            print(
                "Ты спускаешься в небольшой подвал."
            )
            print(
                "На стене висит шахтёрский фонарь."
            )
            print(
                "Сними фонарь и повесь его на себя, "
                "чтобы освободить руки."
            )

            if "ржавый меч" in inventory:

                player_class = "Воин"

                add_item("железный щит")
                armor += 3

            elif "затупившийся кинжал" in inventory:

                player_class = "Разбойник"

                add_item("второй кинжал")
                damage_bonus += 5

            else:

                player_class = "Маг"

                add_item("кольцо маны")
                add_item("боевой посох")

                max_mana = 30
                mana = 30

                damage_bonus += 2
                cast_speed += 0.2

                print()
                print(
                    "Выбери заклинание:"
                )
                print(
                    "1. Огненный шар "
                    "(6 урона + горение)"
                )
                print(
                    "2. Ледяная стрела "
                    "(6 урона + холод)"
                )

                choice = input(
                    "Твой выбор: "
                ).lower().strip()

                if (
                    "2" in choice
                    or "лед" in choice
                ):
                    spell = "Ледяная стрела"
                else:
                    spell = "Огненный шар"

            print()
            print(
                f"Твой класс: {player_class}."
            )
            print(
                "Снаряжение обновлено."
            )

            continue

        # ----------------------------------------------------
        # РЕГЕНЕРАЦИЯ
        # ----------------------------------------------------

        if hp < max_hp:

            hp = min(
                max_hp,
                hp + max_hp * 0.30
            )

            print(
                f"💚 Ты восстанавливаешь "
                f"{max_hp * 0.30:.2f} HP."
            )

        if (
            player_class == "Маг"
            and mana < max_mana
        ):

            mana = min(
                max_mana,
                mana + max_mana * 0.45
            )

            print(
                f"🔷 Мана восстанавливается "
                f"(+{max_mana * 0.45:.2f})."
            )

        # ----------------------------------------------------
        # ДЕЙСТВИЕ В ПОДВАЛЕ
        # ----------------------------------------------------

        print()

        action = input(
            "Что ты делаешь в подвале? "
        ).lower().strip()

        print(
            "\nТы решил:",
            action
        )

        # ----------------------------------------------------
        # ФОНАРЬ
        # ----------------------------------------------------

        if (
            "фонарь" in action
            or "снять" in action
            or "взять" in action
        ):

            if not has_light:

                print(
                    "Ты закрепляешь фонарь на поясе."
                )
                print(
                    "Руки свободны."
                )
                print(
                    "Подвал освещён."
                )

                add_item(
                    "шахтёрский фонарь (экипирован)"
                )

                has_light = True

            else:

                print(
                    "Фонарь уже на тебе."
                )

        # ----------------------------------------------------
        # БЕЗ ФОНАРЯ
        # ----------------------------------------------------

        elif not has_light:

            print(
                "Слишком темно!"
            )
            print(
                "Сначала возьми ФОНАРЬ."
            )

        # ----------------------------------------------------
        # СКЕЛЕТ / КАРТА
        # ----------------------------------------------------

        elif (
            "скелет" in action
            or "карт" in action
        ):

            if "карта местности" in inventory:

                print(
                    "Ты уже забрал карту."
                )

            else:

                print(
                    "Ты обыскиваешь скелет."
                )
                print(
                    "Ты находишь КАРТУ МЕСТНОСТИ."
                )

                add_item(
                    "карта местности"
                )

        # ----------------------------------------------------
        # БОСС — КРЫСОЛЮД
        # ----------------------------------------------------

        elif (
            "дверь" in action
            and ratman_alive
        ):

            print()
            print(
                "Ты толкаешь дверь..."
            )
            print(
                "Из темноты со скрежетом "
                "на тебя бросается КРЫСОЛЮД!"
            )
            print(
                "=" * 70
            )

            enemy_hp = 15
            enemy_poison_duration = 0
            enemy_stunned = False
            pkm_cooldown = 0

            while (
                enemy_hp > 0
                and hp > 0
            ):

                print()
                print(
                    f"Твоё здоровье: "
                    f"{hp:.2f}/{max_hp} HP"
                )
                print(
                    f"Здоровье Крысолюда: "
                    f"{enemy_hp:.2f} HP"
                )

                if player_class == "Маг":

                    print(
                        f"Мана: "
                        f"{mana:.2f}/{max_mana}"
                    )

                print()
                print("--- БОЙ ---")
                print(
                    "лкм — обычная атака"
                )

                if player_class == "Воин":

                    print(
                        "пкм — удар щитом"
                    )

                elif player_class == "Разбойник":

                    print(
                        f"пкм — ядовитый дротик "
                        f"(кулдаун {pkm_cooldown})"
                    )

                elif player_class == "Маг":

                    print(
                        "пкм — магический барьер"
                    )
                    print(
                        f"1 — {spell}"
                    )

                combat_input = input(
                    "Твоя атака: "
                ).lower().strip()

                player_turn_damage = 0
                temp_armor = 0

                # ------------------------------------------------
                # ПРОМАХ
                # ------------------------------------------------

                miss_chance = (
                    random.random() < 0.15
                )

                if miss_chance:

                    print(
                        "❌ ПРОМАХ!"
                    )

                else:

                    # --------------------------------------------
                    # ОБЫЧНАЯ АТАКА
                    # --------------------------------------------

                    if combat_input == "лкм":

                        base_damage = random.uniform(
                            2.5,
                            4.0
                        )

                        total_damage = (
                            base_damage
                            + damage_bonus
                        )

                        if random.random() < 0.25:

                            total_damage *= 1.25

                            print(
                                "💥 КРИТИЧЕСКИЙ УДАР!"
                            )

                        player_turn_damage = (
                            total_damage
                        )

                        print(
                            f"Ты наносишь "
                            f"{player_turn_damage:.2f} урона."
                        )

                    # --------------------------------------------
                    # ВОИН
                    # --------------------------------------------

                    elif (
                        combat_input == "пкм"
                        and player_class == "Воин"
                    ):

                        player_turn_damage = random.randint(
                            2,
                            3
                        )

                        print(
                            f"Ты ударяешь щитом "
                            f"на {player_turn_damage} урона."
                        )

                        if random.random() < 0.05:

                            enemy_stunned = True

                            print(
                                "💫 Крысолюд оглушён!"
                            )

                    # --------------------------------------------
                    # РАЗБОЙНИК
                    # --------------------------------------------

                    elif (
                        combat_input == "пкм"
                        and player_class == "Разбойник"
                    ):

                        if pkm_cooldown == 0:

                            print(
                                "Ты бросаешь "
                                "ядовитый дротик!"
                            )

                            enemy_poison_duration = 2
                            pkm_cooldown = 2

                        else:

                            print(
                                f"Навык ещё "
                                f"перезаряжается: "
                                f"{pkm_cooldown}"
                            )

                            continue

                    # --------------------------------------------
                    # МАГ — БАРЬЕР
                    # --------------------------------------------

                    elif (
                        combat_input == "пкм"
                        and player_class == "Маг"
                    ):

                        if mana >= 5:

                            mana -= 5
                            temp_armor = 2

                            print(
                                "🔷 Ты создаёшь "
                                "магический барьер."
                            )

                        else:

                            print(
                                "Недостаточно маны!"
                            )

                            continue

                    # --------------------------------------------
                    # МАГ — ЗАКЛИНАНИЕ
                    # --------------------------------------------

                    elif (
                        combat_input in ["1", "2"]
                        and player_class == "Маг"
                    ):

                        if mana < 5:

                            print(
                                "Недостаточно маны!"
                            )
                            continue

                        mana -= 5

                        player_turn_damage = 6

                        if spell == "Огненный шар":

                            print(
                                "🔥 Ты запускаешь "
                                "Огненный шар!"
                            )

                            print(
                                "Крысолюд получает "
                                "6 урона и горит."
                            )

                            player_turn_damage += 2

                        else:

                            print(
                                "❄️ Ты выпускаешь "
                                "Ледяную стрелу!"
                            )

                            print(
                                "Крысолюд получает "
                                "6 урона и замедляется."
                            )

                            player_turn_damage += 1.5

                    else:

                        print(
                            "Неправильная команда."
                        )

                # ------------------------------------------------
                # УРОН ВРАГУ
                # ------------------------------------------------

                enemy_hp -= player_turn_damage

                # ------------------------------------------------
                # ЯД
                # ------------------------------------------------

                if (
                    enemy_poison_duration > 0
                    and enemy_hp > 0
                ):

                    enemy_hp -= 0.75
                    enemy_poison_duration -= 1

                    print(
                        "☠️ Яд наносит "
                        "0.75 урона."
                    )

                # ------------------------------------------------
                # КУЛДАУН
                # ------------------------------------------------

                if pkm_cooldown > 0:

                    pkm_cooldown -= 1

                # ------------------------------------------------
                # ПОБЕДА
                # ------------------------------------------------

                if enemy_hp <= 0:

                    print()
                    print(
                        "🎉 КРЫСОЛЮД ПОБЕЖДЁН!"
                    )

                    print(
                        "Ты обыскиваешь его тело."
                    )

                    print(
                        "Ты находишь золотой зуб."
                    )

                    add_item(
                        "золотой зуб крысолюда"
                    )

                    ratman_alive = False

                    break

                # ------------------------------------------------
                # ХОД ВРАГА
                # ------------------------------------------------

                if enemy_stunned:

                    print(
                        "⏳ Крысолюд оглушён "
                        "и пропускает ход."
                    )

                    enemy_stunned = False

                else:

                    enemy_action_chance = random.random()

                    final_armor = (
                        armor
                        + temp_armor
                    )

                    if enemy_action_chance < 0.10:

                        enemy_damage = 5

                        damage_taken = max(
                            1,
                            enemy_damage - final_armor
                        )

                        hp -= damage_taken

                        print(
                            f"⚡ Крысолюд делает рывок "
                            f"и наносит {damage_taken} урона."
                        )

                    else:

                        enemy_damage = random.randint(
                            2,
                            3
                        )

                        damage_taken = max(
                            1,
                            enemy_damage - final_armor
                        )

                        hp -= damage_taken

                        print(
                            f"Крысолюд кусает тебя "
                            f"на {damage_taken} урона."
                        )

                # ------------------------------------------------
                # РЕГЕНЕРАЦИЯ
                # ------------------------------------------------

                if hp < max_hp and hp > 0:

                    hp = min(
                        max_hp,
                        hp + max_hp * 0.13
                    )

                    print(
                        f"❤️ Ты восстанавливаешь "
                        f"{max_hp * 0.13:.2f} HP."
                    )

                if (
                    player_class == "Маг"
                    and mana < max_mana
                    and hp > 0
                ):

                    mana = min(
                        max_mana,
                        mana + max_mana * 0.20
                    )

                    print(
                        f"🔷 Ты восстанавливаешь "
                        f"{max_mana * 0.20:.2f} маны."
                    )

            # ----------------------------------------------------
            # СМЕРТЬ
            # ----------------------------------------------------

            if hp <= 0:

                print()
                print("=" * 45)
                print("              ТЫ МЁРТВ")
                print("=" * 45)
                print(
                    "Твоё путешествие заканчивается "
                    "в темноте подвала."
                )
                print("=" * 45)

                game_running = False
                break

        # ----------------------------------------------------
        # КОМНАТА ПОСЛЕ КРЫСОЛЮДА
        # ----------------------------------------------------

        elif (
            (
                "дверь" in action
                or "сундук" in action
                or "комнат" in action
            )
            and not ratman_alive
        ):

            if not chest_looted:

                print(
                    "Ты проходишь в комнату "
                    "за дверью."
                )

                print(
                    "В углу стоит старый сундук."
                )

                print()
                print(
                    "Ты находишь:"
                )

                print(
                    "• Поношенные штаны (+3 броня)"
                )

                print(
                    "• Малое зелье здоровья (+7 HP)"
                )

                print(
                    "• Консервированное мясо "
                    "кротовиков"
                )

                add_item(
                    "малое зелье здоровья (+7 HP)"
                )

                add_item(
                    "консервированное мясо кротовиков"
                )

                armor += 3

                if player_class == "Маг":

                    if random.random() < 0.75:

                        print(
                            "• Малое зелье маны"
                        )

                        add_item(
                            "малое зелье маны"
                        )

                    else:

                        print(
                            "Малого зелья маны "
                            "в сундуке нет."
                        )

                chest_looted = True

            else:

                print(
                    "Ты уже полностью "
                    "опустошил этот сундук."
                )

        # ----------------------------------------------------
        # ВЫХОД
        # ----------------------------------------------------

